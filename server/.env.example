# Copy to server/.env (or project-root .env). Without a key the IQ roast uses a local formula
# and hints use the solver's plain wording.
# Free Groq key: https://console.groq.com -> API Keys
GROQ_API_KEY=
# LLM_MODEL=openai/gpt-oss-120b   (or qwen/qwen3.8-27b, faster)
# Any OpenAI-compatible endpoint works, e.g. local Ollama (no key needed):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:3b

# AI opponent (single-player). Uses the same GROQ_API_KEY.
# Without it the bot still plays, but answers come from the built-in solver, not the LLM.
# BOT_MODEL=llama-3.3-70b-versatile
# BOT_BASE_URL=https://api.groq.com/openai/v1   # any OpenAI-compatible endpoint works
# BOT_NAME=🤖 Groq Bot

# PORT=3000
# TARGET_MAX=99
